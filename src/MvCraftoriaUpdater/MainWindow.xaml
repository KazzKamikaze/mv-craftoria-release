<Window x:Class="MvCraftoriaUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MV Craftoria Updater" Width="860" Height="590" MinWidth="780" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#111419" Foreground="#F4F6F7">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="74" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171B20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="58" Height="58" Stretch="Uniform" Source="pack://application:,,,/Assets/mv-logo.png" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="MV CRAFTORIA" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="SECURE CLIENT UPDATER" Margin="0,2,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Border Grid.Column="3" VerticalAlignment="Center" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,6" Background="#172825">
                    <TextBlock Text="{Binding SecurityStatus}" Foreground="{StaticResource AccentHoverBrush}"
                               FontSize="10" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="4" Background="#19322D" VerticalAlignment="Center">
                        <TextBlock Text="✓" Foreground="{StaticResource AccentHoverBrush}" FontSize="20"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProfileStatus}" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentHoverBrush}" />
                        <TextBlock Text="{Binding ProfilePath}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   FontSize="13" ToolTip="{Binding ProfilePath}" />
                    </StackPanel>
                    <Button Grid.Column="4" Content="Choose Another" Command="{Binding BrowseCommand}" Padding="13,8" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="18,13">
                    <StackPanel>
                        <TextBlock Text="INSTALLED VERSION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding CurrentVersion}" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="18,13">
                    <StackPanel>
                        <TextBlock Text="LATEST GITHUB RELEASE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding LatestVersion}" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="18,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Text="{Binding StatusDetail}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Changelog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="{StaticResource WarmBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar Grid.Row="6" Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#171B20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="9" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Check Again" Command="{Binding CheckCommand}" />
                <Button Grid.Column="2" Content="Release Details" Command="{Binding OpenReleaseCommand}" />
                <Button Grid.Column="4" Content="Open Logs" Command="{Binding OpenLogsCommand}" />
                <StackPanel Grid.Column="5" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Signed manifest and SHA-256 verification" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="No CurseForge or Minecraft login required" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                </StackPanel>
                <Button Grid.Column="6" Content="{Binding PrimaryActionText}" Command="{Binding UpdateCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="128" />
            </Grid>
        </Border>
    </Grid>
</Window>
