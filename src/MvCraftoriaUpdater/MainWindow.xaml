<Window x:Class="MvCraftoriaUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MV Craftoria Updater" Width="940" Height="620" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#111419" Foreground="#F4F6F7">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="74" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171B20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="58" Height="58" Stretch="Uniform" Source="pack://application:,,,/Assets/mv-logo.png" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="MV CRAFTORIA" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="SECURE CLIENT UPDATER" Margin="0,2,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Border Grid.Column="3" VerticalAlignment="Center" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,6" Background="#172825">
                    <TextBlock Text="{Binding SecurityStatus}" Foreground="{StaticResource AccentHoverBrush}"
                               FontSize="10" FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="18,13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="7" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ProfileStatus}" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentHoverBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                              ToolTip="{Binding ProfilePath}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse Client" Command="{Binding BrowseCommand}" Padding="13,8" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="18,13">
                    <StackPanel>
                        <TextBlock Text="INSTALLED VERSION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding CurrentVersion}" Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="18,13">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="AVAILABLE SIGNED VERSION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <ComboBox Grid.Row="2" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="18,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Text="{Binding StatusDetail}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Changelog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="{StaticResource WarmBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar Grid.Row="6" Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#171B20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="9" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="9" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Check Again" Command="{Binding CheckCommand}" />
                <Button Grid.Column="2" Content="Release Details" Command="{Binding OpenReleaseCommand}" />
                <Button Grid.Column="4" Content="Open Logs" Command="{Binding OpenLogsCommand}" />
                <Button Grid.Column="6" Content="Cancel" Command="{Binding CancelCommand}" Foreground="{StaticResource DangerBrush}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCancel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="8" Content="Install as New Client" Command="{Binding InstallNewCommand}" MinWidth="154" />
                <Button Grid.Column="10" Content="Update Selected Client" Command="{Binding UpdateCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="164" />
            </Grid>
        </Border>
    </Grid>
</Window>
