<Window x:Class="MvCraftoriaUpdater.UpdaterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MV Craftoria Updater" Width="520" SizeToContent="Height" MinHeight="285"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="7">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <Border Background="#171B20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="7,7,0,0" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="34" Height="34" Stretch="Uniform"
                           Source="pack://application:,,,/Assets/mv-logo.png" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="MV CRAFTORIA" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="SECURE CLIENT UPDATER" Margin="0,1,0,0" FontSize="9"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="3" Width="32" Height="32" Padding="0" Content="×"
                            FontSize="19" FontWeight="Normal" ToolTip="Close" Click="OnCloseClick" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,23,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="50" Height="50" VerticalAlignment="Top" CornerRadius="25"
                        Background="{Binding AccentBackground}" BorderBrush="{Binding AccentBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="25"
                               FontWeight="SemiBold" Foreground="{Binding AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Margin="0,10,0,0" FontSize="13"
                               LineHeight="20" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="#171B20" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="20,0">
                    <Button x:Name="SecondaryButton" Content="Cancel" MinWidth="92" Margin="0,0,10,0"
                            Click="OnSecondaryClick" />
                    <Button x:Name="PrimaryButton" Content="Continue" MinWidth="122"
                            Style="{StaticResource PrimaryButton}" Click="OnPrimaryClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
